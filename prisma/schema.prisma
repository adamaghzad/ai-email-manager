generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  emails        Email[]
  cv            CV?
  jobApplications JobApplication[]
  settings      UserSettings?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserSettings {
  id                   String  @id @default(cuid())
  userId               String  @unique
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  smtpHost             String?
  smtpPort             Int?    @default(587)
  smtpUser             String?
  smtpPass             String?  @db.Text
  imapHost             String?
  imapPort             Int?    @default(993)
  imapUser             String?
  imapPass             String?  @db.Text
  emailConnected       Boolean @default(false)
  autoSendEnabled      Boolean @default(false)
  aiModel              String  @default("gpt-4o-mini")
  openaiApiKey         String? @db.Text
  signature            String? @db.Text
  senderName           String?
}

model Email {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId      String?        @unique
  fromAddress     String
  fromName        String?
  toAddress       String
  subject         String
  bodyHtml        String?        @db.Text
  bodyText        String?        @db.Text
  snippet         String?
  category        EmailCategory  @default(INBOX)
  priority        EmailPriority  @default(NORMAL)
  status          EmailStatus    @default(RECEIVED)
  read            Boolean        @default(false)
  starred         Boolean        @default(false)
  folder          String         @default("inbox")
  inReplyTo       String?
  references      String?
  aiSummary       String?        @db.Text
  aiCategory      String?
  aiSuggestedReply String?       @db.Text
  aiTone          String?
  approved        Boolean        @default(false)
  approvedReply   String?        @db.Text
  sentAt          DateTime?
  receivedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  attachments     Attachment[]
  replies         Email[]        @relation("EmailReplies")
  parentEmailId   String?
  parentEmail     Email?         @relation("EmailReplies", fields: [parentEmailId], references: [id])
  jobApplication  JobApplication?

  @@index([userId, folder, status])
  @@index([userId, category])
  @@index([userId, createdAt(sort: Desc)])
}

model Attachment {
  id          String   @id @default(cuid())
  emailId     String
  email       Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  filename    String
  contentType String?
  size        Int?
  url         String?
  storagePath String?
  isCV        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model CV {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename        String
  contentType     String
  size            Int
  url             String
  storagePath     String
  parsedText      String?          @db.Text
  uploadedAt      DateTime         @default(now())
  jobApplications JobApplication[]
}

model JobApplication {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          String
  position         String
  recruiterEmail   String
  recruiterName    String?
  status           JobAppStatus      @default(DRAFT)
  coverLetter      String?           @db.Text
  aiGeneratedLetter String?          @db.Text
  sentEmailId      String?           @unique
  sentEmail        Email?            @relation(fields: [sentEmailId], references: [id])
  emailThreadId    String?
  cvId             String?
  cv               CV?               @relation(fields: [cvId], references: [id])
  notes            String?           @db.Text
  appliedAt        DateTime?
  followUpDate     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId, status])
}

enum EmailCategory {
  INBOX
  JOB_RECRUITMENT
  PERSONAL
  WORK
  PROMOTIONS
  SPAM
  NEWSLETTER
  IMPORTANT
  FOLLOW_UP
  REJECTION
  OFFER
  INTERVIEW_REQUEST
  OTHER
}

enum EmailPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EmailStatus {
  RECEIVED
  DRAFTED
  AI_PROCESSED
  PENDING_APPROVAL
  APPROVED
  SENT
  ARCHIVED
  TRASHED
  SCHEDULED
}

enum JobAppStatus {
  DRAFT
  READY_TO_SEND
  SENT
  INTERVIEW_SCHEDULED
  FOLLOW_UP
  REJECTED
  OFFER_RECEIVED
  ARCHIVED
}
