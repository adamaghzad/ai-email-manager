# -------- Database (Neon Postgres) --------
DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"
DATABASE_DIRECT_URL="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# -------- NextAuth --------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Leave blank in Vercel preview/production — host is auto-detected
NEXTAUTH_URL=""
AUTH_TRUST_HOST="true"

# -------- AI (OpenRouter — OpenAI-compatible, free tier works) --------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
AI_MODEL="google/gemma-4-31b-it:free"
AI_MODEL_FALLBACK="nvidia/nemotron-3.5-lightning:free,google/gemma-4-26b-a4b-it:free"

# Optional: use OpenAI directly instead of OpenRouter
# OPENAI_API_KEY="sk-..."

# -------- Email sending (pick ONE provider) --------
# Option A: Resend (recommended for Vercel) — https://resend.com
RESEND_API_KEY="re_..."
EMAIL_FROM="Your Name <you@yourdomain.com>"

# Option B: SMTP (Gmail / Outlook / custom)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-app-password"

# -------- Uploads --------
UPLOAD_DIR="./public/uploads"
